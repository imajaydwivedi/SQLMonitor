          "editorMode": "code",
          "expr": "100 * sum by (container_name) (rate(container_cpu_usage_seconds_total{job=\"cadvisor\",container_name=~\"$Container\",cpu=\"total\"}[$__rate_interval])) / sum by (container_name) (container_spec_cpu_quota{job=\"cadvisor\",container_name=~\"$Container\"} / container_spec_cpu_period{job=\"cadvisor\",container_name=~\"$Container\"})",
          "legendFormat": "{{container_name}}",
