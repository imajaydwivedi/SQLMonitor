# Copy to .env and edit. `make up` refuses to run without it.

# SA password. SQL Server requires 8+ chars from 3 of: upper, lower, digit,
# symbol - the container silently fails to start if it does not comply.
# Avoid "#": the Makefile includes this file, and make treats # as a comment.
SA_PASSWORD=SqlM0nitor-Test-2026

# Edition. Express is what a free local rig gets you and it DOES run SQL Agent
# on Linux (verified). Switch to Developer for full fidelity - see README.
#   Express | Developer | Evaluation | Standard | Enterprise
MSSQL_PID=Express

MSSQL_IMAGE=mcr.microsoft.com/mssql/server:2022-latest

# Apple Silicon: the mssql images are amd64-only, so they run under Rosetta.
# On an Intel/AMD host you can set this to linux/amd64 too (it is a no-op).
MSSQL_PLATFORM=linux/amd64

# Per-instance memory. SQL Server needs 2 GB minimum; Express caps its buffer
# pool at 1410 MB regardless. Keep MSSQL_MEM_LIMIT above MSSQL_MEMORY_LIMIT_MB.
MSSQL_MEMORY_LIMIT_MB=1536
MSSQL_MEM_LIMIT=2560m

# Host ports (1433 is left free deliberately, in case you run SQL locally).
INVENTORY_PORT=14330
MONITORED1_PORT=14340
GRAFANA_PORT=3000

# Read-only login the linked servers and Grafana use.
GRAFANA_PASSWORD=grafana
GRAFANA_ADMIN_PASSWORD=admin

# 1 = verbose logging from every bin/*.sh
SQLMONITOR_VERBOSE=0
